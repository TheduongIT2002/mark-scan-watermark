[Unit]
Description=MarkScan Big LaMa AI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/markscan/ai-service
Environment=MARKSCAN_AI_DEVICE=cpu
Environment=MARKSCAN_ALLOWED_ORIGINS=http://duongpt.io.vn,http://www.duongpt.io.vn,https://duongpt.io.vn,https://www.duongpt.io.vn
ExecStart=/opt/markscan/ai-service/.venv/bin/python -m uvicorn server:app --host 127.0.0.1 --port 8384
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
