import path from "node:path";import {validateDataset,serializableValidation} from "../src/lib/dataset/validate";import {parseCliOptions} from "../src/lib/dataset/args";
const options=parseCliOptions(process.argv.slice(2));if(!options.root){console.error("Usage: npm run dataset:validate -- --root <authorized-dataset-root> [--json]");process.exit(2);}const result=await validateDataset(path.resolve(options.root));if(options.json)console.log(JSON.stringify(serializableValidation(result),null,2));else{console.log(`Dataset ${result.datasetId??"unknown"}: ${result.status}`);console.log(`Issues: ${result.issues.length}`);for(const item of result.issues)console.log(`- ${item.code}${item.itemId?` [${item.itemId}]`:""}: ${item.message}`);}process.exitCode=result.status==="VALID"?0:1;
