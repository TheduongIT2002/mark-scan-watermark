{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markscan.local/schemas/authorized-logo-dataset-v1.json",
  "title": "Authorized fixed-logo dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetVersion",
    "datasetId",
    "canonicalLogo",
    "rights",
    "benchmark",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "datasetVersion": {
      "type": "string",
      "minLength": 1
    },
    "datasetId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "canonicalLogo": {
      "$ref": "#/$defs/asset"
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized",
        "attestation",
        "attestedAt"
      ],
      "properties": {
        "authorized": {
          "const": true
        },
        "attestation": {
          "type": "string",
          "minLength": 1
        },
        "attestedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirePositiveMasks",
        "requiredSplits"
      ],
      "properties": {
        "requirePositiveMasks": {
          "type": "boolean"
        },
        "requiredSplits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "train",
              "validation",
              "test"
            ]
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "hex"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "hex": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "width",
        "height"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "groupId",
        "imagePath",
        "sha256",
        "width",
        "height",
        "label",
        "split"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "imagePath": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "enum": [
            "positive",
            "negative",
            "difficult-negative"
          ]
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "test"
          ]
        },
        "boundingBox": {
          "$ref": "#/$defs/box"
        },
        "mask": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "category": {
          "type": "string"
        },
        "provenanceNote": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "label": {
                "const": "positive"
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "properties": {
              "boundingBox": {
                "$ref": "#/$defs/box"
              }
            },
            "required": [
              "boundingBox"
            ]
          },
          "else": {
            "properties": {
              "boundingBox": false,
              "mask": false
            }
          }
        }
      ]
    }
  }
}
