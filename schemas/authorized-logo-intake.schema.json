{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://markscan.local/schemas/authorized-logo-intake-v1.json","type":"object","additionalProperties":false,"required":["schemaVersion","datasetVersion","datasetId","canonicalLogoPath","rights","benchmark","items"],
